rules_version = '2';
// Regole Firestore · Posti letto · Ospedale di Stato RSM · versione 3.9.0
// Da pubblicare in Firebase Console › Firestore Database › Regole.
// L'email dell'amministratore deve coincidere con ADMIN_EMAIL in index.html.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'admin@ospedale.local'; }
    function accountPath() { return /databases/$(database)/documents/accounts/$(request.auth.uid); }
    function hasAccount() { return signedIn() && exists(accountPath()); }
    function myDept() { return get(accountPath()).data.dept; }
    function member() { return isAdmin() || hasAccount(); }

    // Elenco dei profili mostrato nella schermata di accesso (solo nomi ed email tecniche).
    match /public/logins {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collegamento account → reparto. Lo crea e lo cancella solo l'amministratore.
    match /accounts/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Reparti: il Pronto Soccorso e l'amministratore leggono tutti i reparti;
    // ogni reparto legge e modifica solo i propri letti.
    match /departments/{id} {
      allow read: if isAdmin() || (hasAccount() && (myDept() == '__ps' || myDept() == id));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (hasAccount() && myDept() == id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rooms', 'updatedAt', 'updatedBy']));
    }

    // Registro attività: ognuno scrive solo a proprio nome e con l'ora del server.
    // Solo l'amministratore legge e cancella. Nessuno può modificare una voce.
    match /audit/{id} {
      allow create: if member()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Sessioni aperte ("Collegati ora"): un documento per finestra aperta.
    match /presence/{pid} {
      allow read: if isAdmin();
      allow create, update: if member()
        && request.resource.data.uid == request.auth.uid
        && pid.matches(request.auth.uid + '_[A-Za-z0-9]+');
      allow delete: if isAdmin() || (signedIn() && pid.matches(request.auth.uid + '_[A-Za-z0-9]+'));
    }

    // Statistiche: una scheda al giorno (AAAA-MM-GG) con la situazione oraria dei reparti
    // e il conteggio di ingressi e dimissioni. La scrivono tutti i profili attivi; la cancella solo l'amministratore.
    match /stats/{day} {
      allow read: if isAdmin();
      allow create, update: if member() && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow delete: if isAdmin();
    }

    // Segnalazioni all'amministratore ("Segnala un problema").
    // Ogni profilo crea segnalazioni solo a proprio nome e per il proprio reparto; il reparto legge le sue
    // (stato e risposta). Solo l'amministratore le aggiorna e le cancella.
    match /reports/{id} {
      allow create: if member()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.status == 'aperta'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (isAdmin() || request.resource.data.dept == myDept());
      allow read: if isAdmin() || (hasAccount() && resource.data.dept == myDept());
      allow update, delete: if isAdmin();
    }

    // Errori tecnici registrati in automatico dai computer (Console tecnica). Solo l'amministratore li legge.
    match /errors/{id} {
      allow create: if member()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Archivio delle password dei reparti, consultabile con l'occhio nell'area amministratore.
    // Solo l'amministratore può leggerlo e scriverlo: nessun reparto e nessun visitatore vi accede.
    match /vault/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
